<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The licence generator.

    THIS TOOL IS NOT DISTRIBUTED TO CUSTOMERS. It holds, or reads, the private key that
    signs licence codes. Anyone with that key can mint licences, so it stays with the
    publisher and the key file is never committed to source control.

    It targets plain net8.0 so it can be run from any machine the publisher happens to be
    using, including a Mac, without needing the Windows desktop stack.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PdfToDicom.LicenceTool</RootNamespace>
    <AssemblyName>pdftodicom-licence</AssemblyName>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfToDicom.Core\PdfToDicom.Core.csproj" />
  </ItemGroup>

</Project>
