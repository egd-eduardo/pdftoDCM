<!--
  Light colour scheme.

  Every colour the interface uses is defined here as a named brush. Templates in
  Controls.xaml reference these keys and never hard code a colour, which is what allows
  the whole application to switch scheme by exchanging this one dictionary.

  Contrast ratios of the text brushes against their surfaces meet WCAG AA, which matters
  on the varied and often poorly calibrated displays found on hospital workstations.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E5EA" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#10528F" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="#F5F8FC" />
    <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#A9C2DD" />
    <SolidColorBrush x:Key="DropZoneActiveBrush" Color="#DCEBFA" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#16202C" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A6675" />
    <SolidColorBrush x:Key="InvertedTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9AA4B0" />

    <!-- Accent and semantic colours -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0F62B0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1272CE" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0B4E8C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1B7F4B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#A96A00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C0271C" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FCEDEC" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#EAF6EF" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FDF4E4" />

    <!-- Controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C3CAD4" />
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#0F62B0" />
    <SolidColorBrush x:Key="InputErrorBorderBrush" Color="#C0271C" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#EFF3F8" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E2E5EA" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#D6E6F7" />

</ResourceDictionary>
