<!--
  Dark colour scheme.

  The palette is not a simple inversion. Surfaces are lifted off pure black so that a
  reading room with the lights down does not produce the halo effect that pure black
  panels create on an LCD, and the accent is lightened to hold its contrast ratio
  against the darker background.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#15181D" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E232A" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2E353F" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#12314F" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#1E232A" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#232931" />
    <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="#1B2432" />
    <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#3C5A76" />
    <SolidColorBrush x:Key="DropZoneActiveBrush" Color="#1D3554" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8ECF1" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A2ADBB" />
    <SolidColorBrush x:Key="InvertedTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6B7786" />

    <!-- Accent and semantic colours -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3D94E8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#57A6F2" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2C7CC6" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CC585" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E0A64B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F0705F" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#3A2320" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#1D3329" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#38301E" />

    <!-- Controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#262C34" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3C444F" />
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#3D94E8" />
    <SolidColorBrush x:Key="InputErrorBorderBrush" Color="#F0705F" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#262C34" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#303842" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2E353F" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#26496E" />

</ResourceDictionary>
