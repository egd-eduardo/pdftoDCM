<Window x:Class="PdfToDicom.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PdfToDicom.App.Infrastructure"
        Title="PDF to DICOM"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}">

    <StackPanel Margin="24">
        <TextBlock x:Name="PromptLabel" Style="{StaticResource FieldLabelTextStyle}" />
        <TextBox x:Name="InputBox" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,20" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Localize Action.Cancel}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    Margin="0,0,8,0" />
            <Button Content="{loc:Localize Action.Ok}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="110" MinHeight="36"
                    IsDefault="True"
                    Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
