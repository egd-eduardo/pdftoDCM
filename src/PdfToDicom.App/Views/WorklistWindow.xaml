<Window x:Class="PdfToDicom.App.Views.WorklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PdfToDicom.App.Converters"
        xmlns:loc="clr-namespace:PdfToDicom.App.Infrastructure"
        Title="{loc:Localize Worklist.Title}"
        Height="620" Width="1040"
        MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A DataGridColumn is not in the visual tree, so it has no DataContext and no
             ancestor to bind through. A resource it can reach does the job. -->
        <conv:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Localize Worklist.Title}" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" />
            <TextBlock Text="{loc:Localize Worklist.Subtitle}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
            <StackPanel>

                <!-- Which server to ask. Shown only when there is more than one, because a
                     picker with a single entry is a decision that looks like a choice. -->
                <StackPanel Margin="0,0,0,12"
                            Visibility="{Binding HasSeveralServers, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Localize Worklist.Server}" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding Servers}"
                              SelectedItem="{Binding SelectedServer}"
                              DisplayMemberPath="Display"
                              Style="{StaticResource InputComboBoxStyle}"
                              IsEnabled="{Binding IsNotBusy}"
                              HorizontalAlignment="Left" MinWidth="260" />
                </StackPanel>

                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Localize Worklist.PatientIdFilter}" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding PatientIdFilter, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             IsEnabled="{Binding IsNotBusy}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Localize Worklist.SurnameFilter}" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding SurnameFilter, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             IsEnabled="{Binding IsNotBusy}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="{loc:Localize Worklist.Search}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SearchCommand}"
                        IsDefault="True"
                        MinWidth="110" MinHeight="36"
                        VerticalAlignment="Bottom" Margin="0,0,8,0" />

                <Button Grid.Column="3"
                        Content="{loc:Localize Worklist.ClearFilters}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearFiltersCommand}"
                        MinWidth="110" MinHeight="36"
                        VerticalAlignment="Bottom" />
                </Grid>

                <TextBlock Text="{loc:Localize Worklist.PatientIdHint}"
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <DataGrid ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Localize Worklist.Column.PatientId}"
                                        Binding="{Binding PatientId}" Width="130" />
                    <!-- The name as the worklist sent it. Any shortening is shown below
                         the grid, so this column is never a half truth. -->
                    <DataGridTextColumn Header="{loc:Localize Worklist.Column.Name}"
                                        Binding="{Binding DisplayName}" Width="*" />
                    <DataGridTextColumn Header="{loc:Localize Worklist.Column.BirthDate}"
                                        Binding="{Binding DisplayDateOfBirth}" Width="110" />
                    <DataGridTextColumn Header="{loc:Localize Worklist.Column.Accession}"
                                        Binding="{Binding AccessionNumber}" Width="140" />
                    <DataGridTextColumn Header="{loc:Localize Worklist.Column.Procedure}"
                                        Binding="{Binding DisplayProcedure}" Width="220" />
                    <DataGridTextColumn Header="{loc:Localize Worklist.Column.Scheduled}"
                                        Binding="{Binding DisplayScheduled}" Width="140" />
                    <!-- Which server the row came from. Two departments can hold a step for
                         the same patient, and the operator has to see which one they are
                         about to file against. Collapsed when only one server was asked. -->
                    <DataGridTextColumn Header="{loc:Localize Worklist.Column.Source}"
                                        Binding="{Binding SourceWorklistName}" Width="150"
                                        Visibility="{Binding Data.ShowsSourceColumn,
                                                     Source={StaticResource ViewModelProxy},
                                                     Converter={StaticResource BoolToVisibility}}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- What will actually be used -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{loc:Localize Worklist.WillBeUsed}" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBlock Text="{Binding SelectionPreview}" Style="{StaticResource FieldLabelTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Status and actions -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="{Binding Status}"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Localize Action.Cancel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        MinWidth="110" MinHeight="36" Margin="0,0,8,0" />
                <Button x:Name="UseButton"
                        Content="{loc:Localize Worklist.Use}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnUse"
                        IsEnabled="{Binding HasSelection}"
                        MinWidth="150" MinHeight="36" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
