<Window x:Class="PdfToDicom.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PdfToDicom.App.Converters"
        xmlns:loc="clr-namespace:PdfToDicom.App.Infrastructure"
        xmlns:vm="clr-namespace:PdfToDicom.App.ViewModels"
        Title="{loc:Localize App.Title}"
        Height="900" Width="1180"
        MinHeight="720" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
        <conv:WorkflowStateToBrushConverter x:Key="StateToBrush" />
        <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <conv:TransmissionOutcomeToBrushConverter x:Key="OutcomeToBrush" />
        <conv:TransmissionOutcomeToTextConverter x:Key="OutcomeToText" />
    </Window.Resources>

    <Window.InputBindings>
        <!-- Keyboard shortcuts keep a busy operator off the mouse. -->
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}" />
        <KeyBinding Key="Return" Modifiers="Control" Command="{Binding GenerateAndSendCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding OpenLogViewerCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding ViewTagsCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowAboutCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Header band -->
            <RowDefinition Height="*" />      <!-- Workflow -->
            <RowDefinition Height="Auto" />   <!-- Action bar -->
            <RowDefinition Height="Auto" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================ Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Localize App.Title}"
                               FontSize="{StaticResource TitleFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InvertedTextBrush}" />
                    <TextBlock Text="{Binding InstitutionHeader}"
                               FontSize="{StaticResource CaptionFontSize}"
                               Foreground="{DynamicResource InvertedTextBrush}"
                               Opacity="0.85"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Localize Action.Logs}"
                            Style="{StaticResource HeaderButtonStyle}"
                            Command="{Binding OpenLogViewerCommand}" />
                    <Button Content="{loc:Localize Action.Settings}"
                            Style="{StaticResource HeaderButtonStyle}"
                            Command="{Binding OpenSettingsCommand}" />
                    <Button Content="{loc:Localize Action.About}"
                            Style="{StaticResource HeaderButtonStyle}"
                            Command="{Binding ShowAboutCommand}" />

                    <!-- A visible way out. The window can be maximised or positioned so
                         that its own close button is off screen, and on a shared
                         workstation the person using it should not have to go looking for
                         the corner. Set apart from the others with a separator, because it
                         is the one button here that ends what you are doing. -->
                    <Border Width="1" Margin="8,4" Background="{DynamicResource InvertedTextBrush}" Opacity="0.35" />

                    <Button Style="{StaticResource HeaderIconButtonStyle}"
                            Command="{Binding ExitCommand}"
                            ToolTip="{loc:Localize Action.Exit.Tooltip}"
                            AutomationProperties.Name="{loc:Localize Action.Exit}">
                        <StackPanel Orientation="Horizontal">
                            <!-- A door frame standing open with an arrow leaving through
                                 it, pointing away from the door. Drawn as a path rather
                                 than shipped as an image so it stays crisp at any display
                                 scaling and needs no resource file. -->
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="{DynamicResource InvertedTextBrush}"
                                  Data="M 2,1 L 9,1 L 9,3 L 4,3 L 4,17 L 9,17 L 9,19 L 2,19 Z
                                        M 19,10 L 14,5 L 14,8.5 L 10,8.5 L 10,11.5 L 14,11.5 L 14,15 Z" />
                            <TextBlock Text="{loc:Localize Action.Exit}"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ Workflow -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="520" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" MinWidth="330" />
                </Grid.ColumnDefinitions>

                <!-- ================================================== Left column -->
                <StackPanel Grid.Column="0">

                    <!-- Step 1: PDF selection -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Localize Step1.Header}" Style="{StaticResource SectionHeaderTextStyle}" />

                            <!-- Drop zone, shown until a document is selected -->
                            <Border x:Name="DropZone"
                                    Visibility="{Binding HasPdf, Converter={StaticResource InverseBoolToVisibility}}"
                                    Background="{DynamicResource DropZoneBackgroundBrush}"
                                    BorderBrush="{DynamicResource DropZoneBorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="24,30"
                                    AllowDrop="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DropZoneActiveBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel HorizontalAlignment="Center">
                                    <!-- A vector document glyph avoids shipping a bitmap and stays sharp at any DPI. -->
                                    <Viewbox Width="52" Height="52" Margin="0,0,0,12">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M6,2 L14,2 L20,8 L20,22 L6,22 Z"
                                                  Fill="{DynamicResource CardBackgroundBrush}"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.4" />
                                            <Path Data="M14,2 L14,8 L20,8"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.4"
                                                  Fill="Transparent" />
                                            <Path Data="M9,13 H17 M9,16 H17 M9,19 H14"
                                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                                  StrokeThickness="1.2" />
                                        </Canvas>
                                    </Viewbox>

                                    <TextBlock Text="{loc:Localize Step1.DropZone}"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,14" />

                                    <Button Content="{loc:Localize Step1.Browse}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding BrowseCommand}"
                                            HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Selected document summary -->
                            <Grid Visibility="{Binding HasPdf, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Viewbox Grid.Column="0" Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M6,2 L14,2 L20,8 L20,22 L6,22 Z"
                                              Fill="{DynamicResource CardBackgroundBrush}"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.4" />
                                        <Path Data="M14,2 L14,8 L20,8"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.4"
                                              Fill="Transparent" />
                                        <TextBlock Canvas.Left="7.2" Canvas.Top="12.5"
                                                   Text="PDF" FontSize="4.4" FontWeight="Bold"
                                                   Foreground="{DynamicResource ErrorBrush}" />
                                    </Canvas>
                                </Viewbox>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding PdfInfo.FileName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{loc:Localize Step1.FileSize}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text=": " />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding PdfInfo.FormattedSize}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="   •   " />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{loc:Localize Step1.Pages}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text=": " />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding PdfPageCountDisplay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{loc:Localize Step1.Created}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text=": " />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                   Text="{Binding PdfInfo.CreatedUtc, StringFormat=g}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                                               Text="{Binding PdfInfo.FullPath}"
                                               TextTrimming="CharacterEllipsis"
                                               Opacity="0.7"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="{loc:Localize Step1.Browse}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding BrowseCommand}"
                                            MinWidth="96" Margin="0,0,8,0" />
                                    <Button Content="{loc:Localize Step1.Clear}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ClearPdfCommand}"
                                            MinWidth="84" />
                                </StackPanel>
                            </Grid>
                                    <!-- Says what the file was recognised as and what it will become. An
                                         operator who dropped the wrong file, or whose scanner produced
                                         something unexpected, sees it here rather than in the archive. -->
                                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="{Binding SourceDescription}"
                                               Visibility="{Binding HasPdf, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- Step 2: Patient information -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{loc:Localize Step2.Header}"
                                           Style="{StaticResource SectionHeaderTextStyle}"
                                           Margin="0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ComboBox ItemsSource="{Binding Templates}"
                                              SelectedItem="{Binding SelectedTemplate}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              MinWidth="140"
                                              MinHeight="30"
                                              Margin="0,0,8,0"
                                              ToolTip="{loc:Localize Step2.Templates}" />
                                    <Button Content="{loc:Localize Step2.Templates}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ApplyTemplateCommand}"
                                            MinWidth="88" MinHeight="30" Margin="0,0,8,0" />
                                    <!-- Only offered when a worklist is configured. A button
                                         that always fails is worse than no button. -->
                                    <Button Content="{loc:Localize Step2.FromWorklist}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding OpenWorklistCommand}"
                                            Visibility="{Binding IsWorklistAvailable, Converter={StaticResource BoolToVisibility}}"
                                            MinWidth="128" MinHeight="30" Margin="0,0,8,0" />
                                    <Button Content="{loc:Localize Step2.ClearForm}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ClearFormCommand}"
                                            MinWidth="106" MinHeight="30" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Patient ID, mandatory, barcode friendly -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Localize Step2.PatientId}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBlock Text=" *" Style="{StaticResource FieldLabelTextStyle}"
                                                   Foreground="{DynamicResource ErrorBrush}" />
                                    </StackPanel>
                                    <TextBox x:Name="PatientIdBox"
                                             Text="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             ToolTip="{loc:Localize Step2.ScanHint}"
                                             TabIndex="1" />
                                </StackPanel>

                                <!-- Accession number, mandatory, barcode friendly -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Localize Step2.AccessionNumber}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBlock Text=" *" Style="{StaticResource FieldLabelTextStyle}"
                                                   Foreground="{DynamicResource ErrorBrush}" />
                                    </StackPanel>
                                    <TextBox Text="{Binding AccessionNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             ToolTip="{loc:Localize Step2.ScanHint}"
                                             TabIndex="2" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Localize Step2.FamilyName}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBlock Text=" *" Style="{StaticResource FieldLabelTextStyle}"
                                                   Foreground="{DynamicResource ErrorBrush}" />
                                    </StackPanel>
                                    <TextBox Text="{Binding FamilyName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" TabIndex="3" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="{loc:Localize Step2.GivenName}" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding GivenName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" TabIndex="4" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Localize Step2.DateOfBirth}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBlock Text=" *" Style="{StaticResource FieldLabelTextStyle}"
                                                   Foreground="{DynamicResource ErrorBrush}" />
                                    </StackPanel>
                                    <DatePicker SelectedDate="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource InputDatePickerStyle}" TabIndex="5" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="{loc:Localize Step2.Sex}" Style="{StaticResource FieldLabelTextStyle}" />
                                    <ComboBox ItemsSource="{Binding SexOptions}"
                                              SelectedValue="{Binding Sex}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Display"
                                              Style="{StaticResource InputComboBoxStyle}" TabIndex="6" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="{loc:Localize Step2.ReferringPhysician}" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding ReferringPhysician, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" TabIndex="7" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="{loc:Localize Step2.DocumentTitle}" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding DocumentTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" TabIndex="8" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="{loc:Localize Step2.StudyDescription}" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding StudyDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" TabIndex="9" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="{loc:Localize Step2.SeriesDescription}" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding SeriesDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" TabIndex="10" />
                                </StackPanel>

                                <!-- Advanced fields, hidden unless the administrator enables them -->
                                <StackPanel Grid.Row="5" Grid.Column="0"
                                            Visibility="{Binding ShowAdvancedFields, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{loc:Localize Step2.StudyInstanceUid}" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding StudyInstanceUid, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" TabIndex="11" />
                                </StackPanel>

                                <StackPanel Grid.Row="5" Grid.Column="2"
                                            Visibility="{Binding ShowAdvancedFields, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{loc:Localize Step2.StudyId}" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding StudyId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" TabIndex="12" />
                                </StackPanel>
                            </Grid>

                            <Button Content="{loc:Localize Step2.SaveTemplate}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding SaveTemplateCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================================================== Right column -->
                <StackPanel Grid.Column="2">

                    <!-- Step 3: Destination -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Localize Step3.Header}" Style="{StaticResource SectionHeaderTextStyle}" />

                            <ItemsControl ItemsSource="{Binding Destinations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SubtleBackgroundBrush}"
                                                CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0">
                                                    <Run Text="{Binding CalledAeTitle, Mode=OneWay}" />
                                                    <Run Text="@" />
                                                    <Run Text="{Binding Host, Mode=OneWay}" />
                                                    <Run Text=":" />
                                                    <Run Text="{Binding Port, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{loc:Localize Step3.NoDestinations}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Destinations.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{loc:Localize Step3.SendToAllEnabled}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,4,0,10" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:Localize Step3.TestConnection}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding TestConnectionCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="{loc:Localize Step3.ManageDestinations}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenSettingsCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Validation findings -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16"
                            Visibility="{Binding HasValidationIssues, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Localize Validation.Title}" Style="{StaticResource SectionHeaderTextStyle}" />
                            <ItemsControl ItemsSource="{Binding ValidationIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,6,8,0"
                                                     Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            <TextBlock Text="{Binding Message}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="300"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Transmission results -->
                    <ItemsControl ItemsSource="{Binding TransmissionResults}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="4" Padding="7,2" Margin="0,0,8,0"
                                                    Background="{Binding Outcome, Converter={StaticResource OutcomeToBrush}}">
                                                <TextBlock Text="{Binding Outcome, Converter={StaticResource OutcomeToText}}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding DestinationName}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" Opacity="0.75">
                                            <Run Text="status " /><Run Text="{Binding DicomStatusCode, Mode=OneWay}" />
                                            <Run Text="  •  attempts " /><Run Text="{Binding AttemptCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Outcome summary -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="{loc:Localize Action.Retry}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RetryCommand}"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="{loc:Localize Action.OpenOutputFolder}"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Command="{Binding OpenOutputFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ============================================================ Action bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Localize Action.ViewTags}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ViewTagsCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{loc:Localize Action.ExportLogs}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ExportLogsCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{loc:Localize Action.Cancel}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelCommand}"
                            MinHeight="48" MinWidth="120" Margin="0,0,10,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{loc:Localize Action.GenerateOnly}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding GenerateOnlyCommand}"
                            MinHeight="48" MinWidth="160" Margin="0,0,10,0" />
                    <Button Content="{loc:Localize Action.GenerateAndSend}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding GenerateAndSendCommand}"
                            IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Fill="{Binding State, Converter={StaticResource StateToBrush}}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <!--
                    RangeBase.Value binds two way by default. The view model drives the
                    bar and never accepts a value back from it, so the mode is stated
                    explicitly. Without it WPF rejects the binding against a read only
                    property and the window fails to load at all.
                -->
                <ProgressBar Grid.Column="2"
                             Width="180" Height="5"
                             VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource SubtleBackgroundBrush}"
                             BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
