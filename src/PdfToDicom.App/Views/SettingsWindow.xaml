<Window x:Class="PdfToDicom.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PdfToDicom.App.Converters"
        xmlns:loc="clr-namespace:PdfToDicom.App.Infrastructure"
        Title="{loc:Localize Settings.Title}"
        Height="720" Width="880"
        MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0">

            <!-- ==================================================== Institution -->
            <TabItem Header="{loc:Localize Settings.Tab.Institution}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Localize Settings.HospitalName}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.HospitalName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.InstitutionName}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.InstitutionName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14"
                                 ToolTip="Written to Institution Name (0008,0080)." />

                        <TextBlock Text="{loc:Localize Settings.DepartmentName}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.DepartmentName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.StationName}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.StationName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.CallingAeTitle}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.CallingAeTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" MaxLength="16"
                                 ToolTip="The AE Title this workstation identifies itself with. Maximum 16 characters." />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0"
                                   Text="Your PACS administrator must configure this AE Title, together with this workstation's IP address, as a known source." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== Destinations -->
            <TabItem Header="{loc:Localize Settings.Tab.Destinations}">
                <Grid Margin="0,16,0,0">

                    <!-- Locked. The same password as the worklist page, and unlocking
                         either one opens both: a wrong destination sends a patient's report to
                         the wrong archive, which is the same kind of mistake as a wrong
                         worklist and deserves the same door. -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="{Binding AreProtectedSettingsLocked, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Localize Settings.Lock.Locked}"
                                       Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,6" />
                            <TextBlock Text="{loc:Localize Settings.Lock.LockedCaption.Destinations}"
                                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="{loc:Localize Settings.Lock.Password}" Style="{StaticResource FieldLabelTextStyle}" />
                            <PasswordBox x:Name="DestinationsPasswordBox"
                                         MinHeight="36" Padding="10,0" Margin="0,0,0,10"
                                         FontSize="{StaticResource BodyFontSize}" />

                            <Button Content="{loc:Localize Settings.Lock.Unlock}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnUnlockSettings"
                                    Tag="{Binding ElementName=DestinationsPasswordBox}"
                                    HorizontalAlignment="Left" MinWidth="130" MinHeight="36" />

                            <TextBlock Text="{Binding LockMessage}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Visibility="{Binding AreProtectedSettingsUnlocked, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{loc:Localize Settings.AddDestination}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding AddDestinationCommand}"
                                        MinWidth="96" Margin="0,0,6,0" />
                                <Button Content="{loc:Localize Settings.RemoveDestination}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RemoveDestinationCommand}"
                                        MinWidth="96" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Destinations}"
                                     SelectedItem="{Binding SelectedDestination}"
                                     Background="{DynamicResource CardBackgroundBrush}"
                                     BorderBrush="{DynamicResource CardBorderBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,5">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}">
                                                <Run Text="{Binding CalledAeTitle, Mode=OneWay}" /><Run Text="@" /><Run Text="{Binding Host, Mode=OneWay}" /><Run Text=":" /><Run Text="{Binding Port, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSelectedDestination, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize Settings.DestinationName}" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding SelectedDestination.Name, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12" />

                                <TextBlock Text="{loc:Localize Settings.CalledAeTitle}" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding SelectedDestination.CalledAeTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}" MaxLength="16" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Localize Settings.Host}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding SelectedDestination.Host, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Localize Settings.Port}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding SelectedDestination.Port, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Localize Settings.Timeout}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding SelectedDestination.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Localize Settings.RetryCount}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding SelectedDestination.RetryCount, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{loc:Localize Settings.RetryDelay}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding SelectedDestination.RetryDelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="{loc:Localize Settings.Enabled}"
                                          IsChecked="{Binding SelectedDestination.IsEnabled}"
                                          Style="{StaticResource SettingCheckBoxStyle}" />
                                <CheckBox Content="{loc:Localize Settings.VerifyBeforeSend}"
                                          IsChecked="{Binding SelectedDestination.VerifyBeforeSend}"
                                          Style="{StaticResource SettingCheckBoxStyle}" />
                                <CheckBox Content="{loc:Localize Settings.UseTls}"
                                          IsChecked="{Binding SelectedDestination.UseTls}"
                                          Style="{StaticResource SettingCheckBoxStyle}" />

                                <Button Content="{loc:Localize Step3.TestConnection}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding TestDestinationCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0" />

                                <Border Background="{DynamicResource SubtleBackgroundBrush}"
                                        CornerRadius="6" Padding="12" Margin="0,10,0,0"
                                        Visibility="{Binding TestResult, Converter={StaticResource StringToVisibility}}">
                                    <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================================================== DICOM -->
            <TabItem Header="{loc:Localize Settings.Tab.Dicom}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Localize Settings.CharacterSet}" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding CharacterSets}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Working.CharacterSet}" DisplayMemberPath="Display"
                                  Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.UidStrategy}" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding UidStrategies}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Working.UidStrategy}" DisplayMemberPath="Display"
                                  Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.OrganizationUidRoot}" Style="{StaticResource FieldLabelTextStyle}" />
                        <!-- Disabled rather than merely read only. It greys the field, which is
                             what a fixed value should look like, and a disabled TextBox cannot be
                             focused, so the text cannot be selected and copied either. -->
                        <TextBox Text="{Binding RegisteredUidRootForDisplay, Mode=OneWay}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,4"
                                 IsEnabled="False"
                                 ToolTipService.ShowOnDisabled="True"
                                 ToolTip="{loc:Localize Settings.OrganizationUidRoot.ToolTip}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,14"
                                   Text="{loc:Localize Settings.OrganizationUidRoot.Caption}" />

                        <TextBlock Text="{loc:Localize Settings.StudyGrouping}" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding StudyGroupingModes}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Working.StudyGrouping}" DisplayMemberPath="Display"
                                  Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,14"
                                   TextWrapping="Wrap"
                                   Text="{loc:Localize Settings.StudyGrouping.Caption}" />

                        <TextBlock Text="{loc:Localize Settings.ImageModality}" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding ImageModalityOptions}"
                                  SelectedItem="{Binding Working.ImageModality}"
                                  Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,14"
                                   TextWrapping="Wrap"
                                   Text="{loc:Localize Settings.ImageModality.Caption}" />

                        <TextBlock Text="{loc:Localize Settings.Modality}" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding ModalityOptions}"
                                  SelectedItem="{Binding Working.Modality}"
                                  Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,14"
                                   Text="OT is accepted by essentially every archive. DOC is the value defined by the current standard for encapsulated documents. Change this only if your PACS administrator asks you to." />

                        <TextBlock Text="{loc:Localize Settings.ConversionType}" Style="{StaticResource FieldLabelTextStyle}" />
                        <!--
                            DisplayMemberPath shows the description while SelectedValuePath
                            keeps the bound value as the bare DICOM code, so the attribute
                            still receives "WSD" and not the sentence explaining it.
                        -->
                        <ComboBox ItemsSource="{Binding ConversionTypeOptions}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding Working.ConversionType}"
                                  Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,14" />

                        <CheckBox Content="{loc:Localize Settings.RenderPdfPagesAsImages}"
                                  IsChecked="{Binding Working.RenderPdfPagesAsImages}"
                                  Style="{StaticResource SettingCheckBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,14"
                                   Text="{loc:Localize Settings.RenderPdfPagesAsImages.Caption}" />

                        <TextBlock Text="{loc:Localize Settings.Manufacturer}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.Manufacturer, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.DefaultDocumentTitle}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.DefaultDocumentTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.DefaultStudyDescription}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.DefaultStudyDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.DefaultSeriesDescription}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.DefaultSeriesDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <CheckBox Content="{loc:Localize Settings.BurnedInAnnotation}"
                                  IsChecked="{Binding Working.BurnedInAnnotation}"
                                  Style="{StaticResource SettingCheckBoxStyle}" />
                        <CheckBox Content="Record the PDF page count in a private attribute"
                                  IsChecked="{Binding Working.RecordPageCountInPrivateTag}"
                                  Style="{StaticResource SettingCheckBoxStyle}" />
                        <CheckBox Content="Include coded document title sequences"
                                  IsChecked="{Binding Working.IncludeConceptNameCodeSequence}"
                                  Style="{StaticResource SettingCheckBoxStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =================================================== Worklist -->
            <TabItem Header="{loc:Localize Settings.Tab.Worklist}">
                <Grid Margin="0,16,0,0">

                    <!-- Locked. The same password as Destinations, and either one opens both. -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="{Binding AreProtectedSettingsLocked, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Localize Settings.Lock.Locked}"
                                       Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,6" />
                            <TextBlock Text="{loc:Localize Settings.Lock.LockedCaption.Worklist}"
                                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="{loc:Localize Settings.Lock.Password}" Style="{StaticResource FieldLabelTextStyle}" />
                            <!-- A plain TextBox would leave the password readable on a
                                 shared clinical workstation. PasswordBox does not expose
                                 its value as a bindable property on purpose, so the button
                                 hands it over through its Tag and the code behind clears
                                 it straight afterwards. -->
                            <PasswordBox x:Name="WorklistPasswordBox"
                                         MinHeight="36" Padding="10,0" Margin="0,0,0,10"
                                         FontSize="{StaticResource BodyFontSize}" />

                            <Button Content="{loc:Localize Settings.Lock.Unlock}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnUnlockSettings"
                                    Tag="{Binding ElementName=WorklistPasswordBox}"
                                    HorizontalAlignment="Left" MinWidth="130" MinHeight="36" />

                            <TextBlock Text="{Binding LockMessage}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Unlocked, or never locked. A list rather than one server: a
                         hospital does not have one worklist, and before this the
                         application could be pointed at only one of them at a time. -->
                    <Grid Visibility="{Binding AreProtectedSettingsUnlocked, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                   Text="{loc:Localize Settings.Lock.Unprotected}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14"
                                   Visibility="{Binding IsSettingsPasswordSet, Converter={StaticResource InverseBoolToVisibility}}" />

                        <DockPanel Grid.Row="1" Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{loc:Localize Settings.AddWorklist}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding AddWorklistCommand}"
                                        MinWidth="96" Margin="0,0,6,0" />
                                <Button Content="{loc:Localize Settings.RemoveWorklist}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RemoveWorklistCommand}"
                                        MinWidth="96" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Worklists}"
                                     SelectedItem="{Binding SelectedWorklist}"
                                     Background="{DynamicResource CardBackgroundBrush}"
                                     BorderBrush="{DynamicResource CardBorderBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,5">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}">
                                                <Run Text="{Binding CalledAeTitle, Mode=OneWay}" /><Run Text="@" /><Run Text="{Binding Host, Mode=OneWay}" /><Run Text=":" /><Run Text="{Binding Port, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSelectedWorklist, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel MaxWidth="560" HorizontalAlignment="Left">

                                <TextBlock Text="{loc:Localize Settings.Worklist.Name}" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding SelectedWorklist.Name, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,4" />
                                <TextBlock Text="{loc:Localize Settings.Worklist.Name.Caption}"
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <CheckBox Content="{loc:Localize Settings.Worklist.Enabled}"
                                  IsChecked="{Binding SelectedWorklist.IsEnabled}"
                                  Style="{StaticResource SettingCheckBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Worklist.CalledAeTitle}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding SelectedWorklist.CalledAeTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Worklist.Host}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding SelectedWorklist.Host, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Worklist.Port}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding SelectedWorklist.Port, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Worklist.CallingAeOverride}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding SelectedWorklist.CallingAeTitleOverride, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Worklist.CallingAeOverride.Caption}"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Worklist.Modality}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding SelectedWorklist.Modality, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Worklist.Modality.Caption}"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Worklist.ScheduledStation}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding SelectedWorklist.ScheduledStationAeTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Worklist.ScheduledStation.Caption}"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Worklist.DateRange}" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding WorklistDateRanges}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedWorklist.DateRange}" DisplayMemberPath="Display"
                                  Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,10" />

                        <!-- Always visible rather than revealed by the choice above. Hiding
                             them would leave "Explicit range" looking like it had no
                             settings, and the caption says plainly when they apply. -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{loc:Localize Settings.Worklist.From}" Style="{StaticResource FieldLabelTextStyle}" />
                                <DatePicker SelectedDate="{Binding SelectedWorklist.ExplicitFrom}" MinHeight="36" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Localize Settings.Worklist.To}" Style="{StaticResource FieldLabelTextStyle}" />
                                <DatePicker SelectedDate="{Binding SelectedWorklist.ExplicitTo}" MinHeight="36" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Localize Settings.Worklist.ExplicitDates.Caption}"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Worklist.Timeout}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding SelectedWorklist.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Worklist.MaximumResults}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding SelectedWorklist.MaximumResults, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Worklist.MaximumResults.Caption}"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <CheckBox Content="{loc:Localize Settings.Worklist.UseTls}"
                                  IsChecked="{Binding SelectedWorklist.UseTls}"
                                  Style="{StaticResource SettingCheckBoxStyle}" Margin="0,0,0,10" />

                        <CheckBox Content="{loc:Localize Settings.Worklist.AcceptAnyCertificate}"
                                  IsChecked="{Binding SelectedWorklist.AcceptAnyTlsCertificate}"
                                  IsEnabled="{Binding SelectedWorklist.UseTls}"
                                  Style="{StaticResource SettingCheckBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Worklist.AcceptAnyCertificate.Caption}"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Button Content="{loc:Localize Settings.Worklist.Test}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding TestWorklistCommand}"
                                HorizontalAlignment="Left" MinWidth="150" MinHeight="36" />

                        <TextBlock Text="{Binding WorklistTestResult}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================================================== Backup -->
            <TabItem Header="{loc:Localize Settings.Tab.Backup}">
                <Grid Margin="0,16,0,0">

                    <!-- Locked, like the two pages whose entries it carries. This page
                         both discloses the addresses of clinical systems and can replace
                         them wholesale, so leaving it open while they are shut would have
                         made the password decorative. -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="{Binding AreProtectedSettingsLocked, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Localize Settings.Lock.Locked}"
                                       Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,6" />
                            <TextBlock Text="{loc:Localize Settings.Lock.LockedCaption.Backup}"
                                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="{loc:Localize Settings.Lock.Password}" Style="{StaticResource FieldLabelTextStyle}" />
                            <PasswordBox x:Name="BackupPasswordBox"
                                         MinHeight="36" Padding="10,0" Margin="0,0,0,10"
                                         FontSize="{StaticResource BodyFontSize}" />

                            <Button Content="{loc:Localize Settings.Lock.Unlock}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnUnlockSettings"
                                    Tag="{Binding ElementName=BackupPasswordBox}"
                                    HorizontalAlignment="Left" MinWidth="130" MinHeight="36" />

                            <TextBlock Text="{Binding LockMessage}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,4,4"
                                  Visibility="{Binding AreProtectedSettingsUnlocked, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">

                            <TextBlock Text="{loc:Localize Settings.Backup.Intro}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" Margin="0,0,0,16" />

                            <TextBlock Text="{loc:Localize Settings.Backup.Include}"
                                       Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,2" />

                            <CheckBox Content="{loc:Localize Settings.Backup.IncludeDestinations}"
                                      IsChecked="{Binding TransferDestinations}"
                                      Style="{StaticResource SettingCheckBoxStyle}" />
                            <CheckBox Content="{loc:Localize Settings.Backup.IncludeWorklists}"
                                      IsChecked="{Binding TransferWorklists}"
                                      Style="{StaticResource SettingCheckBoxStyle}" Margin="0,6,0,16" />

                            <Button Content="{loc:Localize Settings.Backup.Export}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ExportSettingsCommand}"
                                    HorizontalAlignment="Left" MinWidth="190" MinHeight="36" />
                            <TextBlock Text="{loc:Localize Settings.Backup.ExportCaption}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" Margin="0,6,0,20" />

                            <TextBlock Text="{loc:Localize Settings.Backup.Mode}"
                                       Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,2" />

                            <!-- Two buttons over one piece of state: the view model exposes
                                 the choice and its opposite, so they cannot disagree. -->
                            <RadioButton Content="{loc:Localize Settings.Backup.Mode.Add}"
                                         GroupName="ImportMode"
                                         IsChecked="{Binding ImportAdds}"
                                         Style="{StaticResource SettingRadioButtonStyle}" />
                            <RadioButton Content="{loc:Localize Settings.Backup.Mode.Replace}"
                                         GroupName="ImportMode"
                                         IsChecked="{Binding ImportReplaces}"
                                         Style="{StaticResource SettingRadioButtonStyle}" Margin="0,6,0,16" />

                            <Button Content="{loc:Localize Settings.Backup.Import}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ImportSettingsCommand}"
                                    HorizontalAlignment="Left" MinWidth="190" MinHeight="36" />
                            <TextBlock Text="{loc:Localize Settings.Backup.ImportCaption}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" Margin="0,6,0,16" />

                            <TextBlock Text="{Binding TransferStatus}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ==================================================== Folders -->
            <TabItem Header="{loc:Localize Settings.Tab.Folders}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Localize Settings.OutputFolder}" Style="{StaticResource FieldLabelTextStyle}" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Working.OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}" />
                            <Button Grid.Column="1" Content="{loc:Localize Settings.Browse}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BrowseOutputFolderCommand}"
                                    MinWidth="96" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="{loc:Localize Settings.LogFolder}" Style="{StaticResource FieldLabelTextStyle}" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Working.LogFolder, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}" />
                            <Button Grid.Column="1" Content="{loc:Localize Settings.Browse}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BrowseLogFolderCommand}"
                                    MinWidth="96" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="{loc:Localize Settings.DefaultPdfFolder}" Style="{StaticResource FieldLabelTextStyle}" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Working.DefaultPdfFolder, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}" />
                            <Button Grid.Column="1" Content="{loc:Localize Settings.Browse}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BrowsePdfFolderCommand}"
                                    MinWidth="96" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="{loc:Localize Settings.LogRetention}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.LogRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Width="120"
                                 HorizontalAlignment="Left" Margin="0,0,0,14" />

                        <CheckBox Content="{loc:Localize Settings.AlwaysSaveLocally}"
                                  IsChecked="{Binding Working.AlwaysSaveDicomLocally}"
                                  Style="{StaticResource SettingCheckBoxStyle}" />
                        <CheckBox Content="{loc:Localize Settings.AutoDelete}"
                                  IsChecked="{Binding Working.AutoDeleteAfterSuccessfulTransmission}"
                                  Style="{StaticResource SettingCheckBoxStyle}" />

                        <Separator Margin="0,14" Background="{DynamicResource SeparatorBrush}" />

                        <CheckBox Content="{loc:Localize Settings.EnableFolderMonitoring}"
                                  IsChecked="{Binding Working.EnableFolderMonitoring}"
                                  Style="{StaticResource SettingCheckBoxStyle}" />

                        <TextBlock Text="{loc:Localize Settings.MonitoredFolder}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,8,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Working.MonitoredFolder, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     IsEnabled="{Binding Working.EnableFolderMonitoring}" />
                            <Button Grid.Column="1" Content="{loc:Localize Settings.Browse}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BrowseMonitoredFolderCommand}"
                                    IsEnabled="{Binding Working.EnableFolderMonitoring}"
                                    MinWidth="96" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== Filename import -->
            <TabItem Header="{loc:Localize Settings.Tab.Import}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">

                        <TextBlock Text="{loc:Localize Settings.Import.Intro}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <CheckBox Content="{loc:Localize Settings.Import.Enabled}"
                                  IsChecked="{Binding Working.FilenameImport.IsEnabled}"
                                  Style="{StaticResource SettingCheckBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Import.Enabled.Caption}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <!-- Build a layout by pressing the fields off in the order they
                             appear in a real file name. The box below stays editable, so
                             anything the picker cannot express is still typed by hand. -->
                        <TextBlock Text="{loc:Localize Settings.Import.Build}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="{loc:Localize Settings.Import.Build.Caption}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding FilenameFieldChoices}" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.AddFieldCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Token}"
                                            ToolTip="{Binding Placeholder}"
                                            Content="{Binding Display}"
                                            MinHeight="30" Margin="0,0,6,6" Padding="12,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding PatternUnderConstruction, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="{loc:Localize Settings.Import.Build.Use}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding UsePatternCommand}"
                                        MinWidth="110" Margin="0,0,6,0" />
                                <Button Content="{loc:Localize Settings.Import.Build.Clear}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ClearPatternCommand}"
                                        MinWidth="90" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="{loc:Localize Settings.Import.Build.Separator}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding PatternSeparator, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Width="60" />
                        </StackPanel>

                        <TextBlock Text="{loc:Localize Settings.Import.Patterns}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding FilenamePatternsText, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 MinHeight="84" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Import.Patterns.Caption}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Import.DateFormats}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding FilenameDateFormatsText, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="60" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Import.DateFormats.Caption}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />

                        <!-- Each shows the format and the same date written in it, because
                             "ddMMyyyy" means nothing to most people and "21051970" is
                             recognised instantly. Pressing one appends it to the box above,
                             in the order they are pressed. -->
                        <ItemsControl ItemsSource="{Binding DateFormatChoices}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.AddDateFormatCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Format}"
                                            Content="{Binding Display}"
                                            MinHeight="30" Margin="0,0,6,6" Padding="12,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Localize Settings.Import.PadPatientId}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.FilenameImport.PadPatientIdTo, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Width="120"
                                 HorizontalAlignment="Left" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Import.PadPatientId.Caption}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Import.DefaultSex}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.FilenameImport.DefaultSex, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Width="120"
                                 HorizontalAlignment="Left" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Import.DefaultSex.Caption}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <CheckBox Content="{loc:Localize Settings.Import.UseFileDate}"
                                  IsChecked="{Binding Working.FilenameImport.UseFileDateAsStudyDate}"
                                  Style="{StaticResource SettingCheckBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Import.UseFileDate.Caption}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <CheckBox Content="{loc:Localize Settings.Import.SplitNames}"
                                  IsChecked="{Binding Working.FilenameImport.SplitRunTogetherNames}"
                                  Style="{StaticResource SettingCheckBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Import.SplitNames.Caption}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Separator Margin="0,4,0,14" Background="{DynamicResource SeparatorBrush}" />

                        <TextBlock Text="{loc:Localize Settings.Import.After}" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding ImportedFileDispositions}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Working.FilenameImport.AfterImport}" DisplayMemberPath="Display"
                                  Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Import.After.Caption}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Import.ImportedSubfolder}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.FilenameImport.ImportedSubfolder, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Import.FailedSubfolder}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.FilenameImport.FailedSubfolder, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Import.FailedSubfolder.Caption}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Localize Settings.Import.RenameSuffix}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Working.FilenameImport.RenameSuffix, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" Width="200"
                                 HorizontalAlignment="Left" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Localize Settings.Import.RenameSuffix.Caption}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Separator Margin="0,4,0,14" Background="{DynamicResource SeparatorBrush}" />

                        <!-- Trying a name here is the whole reason an administrator can get
                             this right first time. It reads the settings as they are being
                             edited, so there is no need to save and reopen. -->
                        <TextBlock Text="{loc:Localize Settings.Import.Test}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="{loc:Localize Settings.Import.Test.Caption}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding FilenameTestName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}" />
                            <Button Grid.Column="1" Content="{loc:Localize Settings.Import.Test.Button}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding TestFilenameCommand}"
                                    MinWidth="110" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="{Binding FilenameTestResult}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding FilenameTestResult, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== Appearance -->
            <!-- ================================================== HL7 inspector -->

            <TabItem Header="{loc:Localize Settings.Tab.Hl7}">
                <Grid Margin="0,16,0,0">

                    <!-- Locked, like the pages whose material it shows. An inspection puts
                         a patient's name, identifier and clinical text on screen beside a
                         destination's configuration, which is the same material the
                         Destinations and Worklist pages keep behind this password. Putting
                         it a click away on the main window would have handed all of it to
                         an operator with no reason to see any of it. -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="{Binding AreProtectedSettingsLocked, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Localize Settings.Lock.Locked}"
                                       Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,6" />
                            <TextBlock Text="{loc:Localize Settings.Lock.LockedCaption.Hl7}"
                                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="{loc:Localize Settings.Lock.Password}" Style="{StaticResource FieldLabelTextStyle}" />
                            <PasswordBox x:Name="Hl7PasswordBox"
                                         MinHeight="36" Padding="10,0" Margin="0,0,0,10"
                                         FontSize="{StaticResource BodyFontSize}" />

                            <Button Content="{loc:Localize Settings.Lock.Unlock}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnUnlockSettings"
                                    Tag="{Binding ElementName=Hl7PasswordBox}"
                                    HorizontalAlignment="Left" MinWidth="130" MinHeight="36" />

                            <TextBlock Text="{Binding LockMessage}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <TabControl Visibility="{Binding AreProtectedSettingsUnlocked, Converter={StaticResource BoolToVisibility}}">

                        <!-- ============================================ Destinations -->

                        <TabItem Header="{loc:Localize Settings.Hl7.Tab.Destinations}">
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="{loc:Localize Settings.Hl7.Destinations.Title}"
                                                   Style="{StaticResource SectionHeaderTextStyle}" />
                                        <TextBlock Text="{loc:Localize Settings.Hl7.Destinations.Caption}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Localize Settings.Hl7.Steps.Title}"
                                                   Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBlock Text="{loc:Localize Settings.Hl7.Steps.Body}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,2,0,8" />
                                        <TextBlock Text="{loc:Localize Settings.Hl7.Destinations.Required}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{loc:Localize Settings.Hl7.Destinations.Example}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{loc:Localize Settings.Hl7.Steps.Example}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{loc:Localize Settings.Hl7.AddDestination}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding AddHl7DestinationCommand}"
                                                MinWidth="90" Margin="0,0,6,0" />
                                        <Button Content="{loc:Localize Settings.Hl7.AddExampleDestination}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding AddExampleHl7DestinationCommand}"
                                                MinWidth="90" Margin="0,0,6,0" />
                                        <Button Content="{loc:Localize Settings.Hl7.RemoveDestination}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding RemoveHl7DestinationCommand}"
                                                MinWidth="90" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding Hl7.Destinations}"
                                             SelectedItem="{Binding SelectedHl7Destination}"
                                             Background="{DynamicResource CardBackgroundBrush}"
                                             BorderBrush="{DynamicResource CardBorderBrush}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,5">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource CaptionTextStyle}">
                                                        <Run Text="{Binding Host, Mode=OneWay}" /><Run Text=":" /><Run Text="{Binding Port, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>

                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasSelectedHl7Destination, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Localize Settings.Hl7.DestinationName}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding SelectedHl7Destination.Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Localize Settings.Host}" Style="{StaticResource FieldLabelTextStyle}" />
                                                <TextBox Text="{Binding SelectedHl7Destination.Host, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Localize Settings.Port}" Style="{StaticResource FieldLabelTextStyle}" />
                                                <TextBox Text="{Binding SelectedHl7Destination.Port, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputTextBoxStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox Content="{loc:Localize Settings.Hl7.DestinationEnabled}"
                                                  IsChecked="{Binding SelectedHl7Destination.IsEnabled}"
                                                  Style="{StaticResource SettingCheckBoxStyle}" />

                                        <!-- The four names. Grouped together because they are
                                             read as a set by the receiver, and because one of
                                             them being wrong is the commonest reason a first
                                             message is rejected without explanation. -->
                                        <TextBlock Text="{loc:Localize Settings.Hl7.SendingApplication}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding SelectedHl7Destination.SendingApplication, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10" />

                                        <TextBlock Text="{loc:Localize Settings.Hl7.SendingFacility}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding SelectedHl7Destination.SendingFacility, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10" />

                                        <TextBlock Text="{loc:Localize Settings.Hl7.ReceivingApplication}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding SelectedHl7Destination.ReceivingApplication, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10" />

                                        <TextBlock Text="{loc:Localize Settings.Hl7.ReceivingFacility}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding SelectedHl7Destination.ReceivingFacility, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Localize Settings.Hl7.ConnectTimeout}" Style="{StaticResource FieldLabelTextStyle}" />
                                                <TextBox Text="{Binding SelectedHl7Destination.ConnectTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Localize Settings.Hl7.ReceiveTimeout}" Style="{StaticResource FieldLabelTextStyle}" />
                                                <TextBox Text="{Binding SelectedHl7Destination.ReceiveTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputTextBoxStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Localize Settings.Hl7.Retries}" Style="{StaticResource FieldLabelTextStyle}" />
                                                <TextBox Text="{Binding SelectedHl7Destination.RetryCount, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Localize Settings.Hl7.RetryDelay}" Style="{StaticResource FieldLabelTextStyle}" />
                                                <TextBox Text="{Binding SelectedHl7Destination.RetryDelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputTextBoxStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{loc:Localize Settings.Hl7.RetriesCaption}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                                        <CheckBox Content="{loc:Localize Settings.Hl7.UseTls}"
                                                  IsChecked="{Binding SelectedHl7Destination.UseTls}"
                                                  Style="{StaticResource SettingCheckBoxStyle}" />
                                        <CheckBox Content="{loc:Localize Settings.Hl7.AcceptAnyCertificate}"
                                                  IsChecked="{Binding SelectedHl7Destination.AcceptAnyTlsCertificate}"
                                                  Style="{StaticResource SettingCheckBoxStyle}" />

                                        <TextBlock Text="{loc:Localize Settings.Hl7.RestrictProfiles}" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding Hl7RestrictToProfiles, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                        <TextBlock Text="{loc:Localize Settings.Hl7.RestrictProfilesCaption}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,2,0,14" />

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{loc:Localize Settings.Hl7.Test}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding TestHl7DestinationCommand}"
                                                    MinWidth="150" MinHeight="36" Margin="0,0,8,0" />
                                            <Button Content="{loc:Localize Settings.Hl7.SendTestMessage}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding SendHl7TestMessageCommand}"
                                                    MinWidth="180" MinHeight="36" />
                                        </StackPanel>
                                        <TextBlock Text="{loc:Localize Settings.Hl7.TestCaption}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock Text="{loc:Localize Settings.Hl7.SendTestMessageCaption}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Hl7DestinationStatus}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- ================================================= Routing -->

                        <TabItem Header="{loc:Localize Settings.Hl7.Tab.Routing}">
                            <DockPanel Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="{loc:Localize Settings.Hl7.Routing.Title}"
                                               Style="{StaticResource SectionHeaderTextStyle}" />
                                    <TextBlock Text="{loc:Localize Settings.Hl7.Routing.Caption}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Localize Settings.Hl7.Steps.Title}"
                                                       Style="{StaticResource FieldLabelTextStyle}" />
                                            <TextBlock Text="{loc:Localize Settings.Hl7.Steps.Body}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap" Margin="0,2,0,8" />
                                            <TextBlock Text="{loc:Localize Settings.Hl7.Routing.Required}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{loc:Localize Settings.Hl7.Routing.Example}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{loc:Localize Settings.Hl7.Steps.Example}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>


                                    <!-- The switch that makes any of this live. Off by
                                         default, and at the top of the page rather than
                                         buried, because somebody looking for why nothing is
                                         being sent should find it first. -->
                                    <CheckBox Content="{loc:Localize Settings.Hl7.Announce}"
                                              IsChecked="{Binding Hl7.AnnounceConversions}"
                                              Style="{StaticResource SettingCheckBoxStyle}" />
                                    <TextBlock Text="{loc:Localize Settings.Hl7.AnnounceCaption}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap" Margin="24,0,0,10" />

                                    <TextBlock Text="{loc:Localize Settings.Hl7.Sequence}" Style="{StaticResource FieldLabelTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Hl7Sequences}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Hl7.Sequence}" DisplayMemberPath="Display"
                                              Style="{StaticResource InputComboBoxStyle}" MaxWidth="520"
                                              HorizontalAlignment="Left" Margin="0,0,0,4" />
                                    <TextBlock Text="{loc:Localize Settings.Hl7.SequenceCaption}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap" Margin="0,0,0,12" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Button Content="{loc:Localize Settings.Hl7.Check}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CheckHl7ConfigurationCommand}"
                                            HorizontalAlignment="Left" MinWidth="170" MinHeight="36" />
                                    <TextBlock Text="{Binding Hl7ConfigurationStatus}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap">
                                        <Run Text="{loc:Localize Settings.Hl7.SettingsFile}" /><Run Text=": " /><Run Text="{Binding Hl7SettingsFilePath, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <DockPanel Grid.Column="0">
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{loc:Localize Settings.Hl7.AddRule}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding AddHl7RuleCommand}"
                                                    MinWidth="72" Margin="0,0,6,0" />
                                            <Button Content="{loc:Localize Settings.Hl7.AddExampleRule}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding AddExampleHl7RuleCommand}"
                                                    MinWidth="78" Margin="0,0,6,0" />
                                            <Button Content="{loc:Localize Settings.Hl7.RemoveRule}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding RemoveHl7RuleCommand}"
                                                    MinWidth="80" Margin="0,0,6,0" />
                                            <Button Content="{loc:Localize Settings.Hl7.MoveUp}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding MoveHl7RuleUpCommand}"
                                                    MinWidth="70" Margin="0,0,6,0" />
                                            <Button Content="{loc:Localize Settings.Hl7.MoveDown}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding MoveHl7RuleDownCommand}"
                                                    MinWidth="70" />
                                        </StackPanel>

                                        <ListBox ItemsSource="{Binding Hl7.Rules}"
                                                 SelectedItem="{Binding SelectedHl7Rule}"
                                                 Background="{DynamicResource CardBackgroundBrush}"
                                                 BorderBrush="{DynamicResource CardBorderBrush}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,5">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding DisplayConditions, Mode=OneWay}"
                                                                   Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>

                                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding HasSelectedHl7Rule, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Localize Settings.Hl7.RuleName}" Style="{StaticResource FieldLabelTextStyle}" />
                                            <TextBox Text="{Binding SelectedHl7Rule.Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12" />

                                            <CheckBox Content="{loc:Localize Settings.Hl7.RuleEnabled}"
                                                      IsChecked="{Binding SelectedHl7Rule.Enabled}"
                                                      Style="{StaticResource SettingCheckBoxStyle}" />

                                            <TextBlock Text="{loc:Localize Settings.Hl7.RuleProfile}" Style="{StaticResource FieldLabelTextStyle}" />
                                            <ComboBox ItemsSource="{Binding Hl7ProfileIdsForRules}"
                                                      SelectedItem="{Binding SelectedHl7Rule.ProfileId}"
                                                      IsEditable="True"
                                                      Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,12" />

                                            <TextBlock Text="{loc:Localize Settings.Hl7.RuleDestination}" Style="{StaticResource FieldLabelTextStyle}" />
                                            <ComboBox ItemsSource="{Binding Hl7.Destinations}"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedHl7RuleDestinationId}" DisplayMemberPath="DisplaySummary"
                                                      Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,12" />

                                            <CheckBox Content="{loc:Localize Settings.Hl7.RuleStopOnMatch}"
                                                      IsChecked="{Binding SelectedHl7Rule.StopOnMatch}"
                                                      Style="{StaticResource SettingCheckBoxStyle}" />

                                            <TextBlock Text="{loc:Localize Settings.Hl7.Conditions}"
                                                       Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,4" />
                                            <TextBlock Text="{loc:Localize Settings.Hl7.ConditionsCaption}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding Hl7ConditionKeysText, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       FontFamily="Consolas, Courier New"
                                                       TextWrapping="Wrap" Margin="0,0,0,8" />

                                            <DataGrid ItemsSource="{Binding SelectedHl7Rule.When}"
                                                      SelectedItem="{Binding SelectedHl7Condition}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      Background="{DynamicResource CardBackgroundBrush}"
                                                      BorderBrush="{DynamicResource CardBorderBrush}"
                                                      MinHeight="120" MaxHeight="220">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{loc:Localize Settings.Hl7.ConditionKey}"
                                                                        Binding="{Binding Key}" Width="*" />
                                                    <DataGridTextColumn Header="{loc:Localize Settings.Hl7.ConditionValue}"
                                                                        Binding="{Binding Value}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="{loc:Localize Settings.Hl7.AddCondition}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding AddHl7ConditionCommand}"
                                                        MinWidth="150" Margin="0,0,6,0" />
                                                <Button Content="{loc:Localize Settings.Hl7.RemoveCondition}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding RemoveHl7ConditionCommand}"
                                                        MinWidth="96" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </TabItem>

                        <!-- ================================================ Profiles -->

                        <TabItem Header="{loc:Localize Settings.Hl7.Tab.Profiles}">
                            <DockPanel Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="{loc:Localize Settings.Hl7.Profiles.Title}"
                                               Style="{StaticResource SectionHeaderTextStyle}" />
                                    <TextBlock Text="{loc:Localize Settings.Hl7.Profiles.Caption}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Localize Settings.Hl7.Steps.Title}"
                                                       Style="{StaticResource FieldLabelTextStyle}" />
                                            <TextBlock Text="{loc:Localize Settings.Hl7.Steps.Body}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap" Margin="0,2,0,8" />
                                            <TextBlock Text="{loc:Localize Settings.Hl7.Profiles.Required}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{loc:Localize Settings.Hl7.Profiles.Example}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{loc:Localize Settings.Hl7.Steps.Example}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{loc:Localize Settings.Hl7.InstallExampleProfile}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding InstallExampleHl7ProfileCommand}"
                                                MinWidth="160" MinHeight="36" Margin="0,0,6,0" />
                                        <Button Content="{loc:Localize Settings.Hl7.ImportProfile}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ImportHl7ProfileCommand}"
                                                MinWidth="150" MinHeight="36" Margin="0,0,6,0" />
                                        <Button Content="{loc:Localize Settings.Hl7.RemoveProfile}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding RemoveHl7ProfileCommand}"
                                                MinWidth="96" MinHeight="36" Margin="0,0,6,0" />
                                        <Button Content="{loc:Localize Settings.Hl7.RefreshProfiles}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding RefreshHl7ProfilesCommand}"
                                                MinWidth="150" MinHeight="36" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap">
                                        <Run Text="{loc:Localize Settings.Hl7.ProfileFolder}" /><Run Text=": " /><Run Text="{Binding Hl7ProfileFolder, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ListBox Grid.Column="0"
                                             ItemsSource="{Binding Hl7Profiles}"
                                             SelectedItem="{Binding SelectedHl7Profile}"
                                             Background="{DynamicResource CardBackgroundBrush}"
                                             BorderBrush="{DynamicResource CardBorderBrush}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,5">
                                                    <TextBlock Text="{Binding DisplaySummary, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ProfileId, Mode=OneWay}"
                                                               Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- A profile that cannot be used is listed with the
                                         reader's objection rather than hidden, so one broken
                                         by a hand edit is visible here instead of simply
                                         absent from the list. -->
                                    <DockPanel Grid.Column="2">
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="{loc:Localize Settings.Hl7.ProfileObjections}"
                                                   Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBlock DockPanel.Dock="Top"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8">
                                            <Run Text="{loc:Localize Settings.Hl7.ProfileFile}" /><Run Text=": " /><Run Text="{Binding SelectedHl7Profile.Path, Mode=OneWay}" />
                                        </TextBlock>

                                        <DataGrid ItemsSource="{Binding SelectedHl7Profile.Issues}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  Background="{DynamicResource CardBackgroundBrush}"
                                                  BorderBrush="{DynamicResource CardBorderBrush}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Localize Settings.Hl7.Where}"
                                                                    Binding="{Binding Location}" Width="150" />
                                                <DataGridTextColumn Header="{loc:Localize Settings.Hl7.What}"
                                                                    Binding="{Binding Message}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </TabItem>

                        <!-- =============================================== Inspector -->

                        <TabItem Header="{loc:Localize Settings.Hl7.Tab.Inspector}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>

                        <!-- What goes in -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{loc:Localize Settings.Hl7.Title}"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{loc:Localize Settings.Hl7.Caption}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{loc:Localize Settings.Hl7.Inspector.Optional}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,12" />

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{loc:Localize Settings.Hl7.Inspect}"
                                        Command="{Binding InspectHl7Command}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="130" MinHeight="36" Margin="0,0,8,0" />
                                <Button Content="{loc:Localize Settings.Hl7.Clear}"
                                        Command="{Binding ClearHl7Command}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="110" MinHeight="36" />
                            </StackPanel>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right"
                                            Content="{loc:Localize Settings.Hl7.Browse}"
                                            Command="{Binding BrowseHl7MessageCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="90" MinHeight="28" />
                                    <TextBlock Text="{loc:Localize Settings.Hl7.Message}"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <TextBox Grid.Row="1"
                                         Text="{Binding Hl7MessageText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas, Courier New"
                                         MinHeight="110" Margin="0,0,0,12" />

                                <DockPanel Grid.Row="2" Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right"
                                            Content="{loc:Localize Settings.Hl7.Browse}"
                                            Command="{Binding BrowseHl7ProfileCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="90" MinHeight="28" />
                                    <TextBlock Text="{loc:Localize Settings.Hl7.Profile}"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <TextBox Grid.Row="3"
                                         Text="{Binding Hl7ProfileText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas, Courier New"
                                         MinHeight="110" />
                            </Grid>
                        </DockPanel>

                        <!-- What comes out -->
                        <DockPanel Grid.Column="2"
                                   Visibility="{Binding HasHl7Inspection, Converter={StaticResource BoolToVisibility}}">

                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding Hl7Summary}"
                                       Style="{StaticResource SectionHeaderTextStyle}"
                                       TextWrapping="Wrap" />

                            <Border DockPanel.Dock="Top"
                                    Style="{StaticResource CardBorderStyle}"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding HasHl7MissingFields, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Localize Settings.Hl7.Missing}"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Foreground="{DynamicResource ErrorBrush}" />
                                    <ItemsControl ItemsSource="{Binding Hl7MissingFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0">
                                                    <Run Text="{Binding Path, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Name, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TabControl Background="Transparent" BorderThickness="0">
                                <TabItem Header="{loc:Localize Settings.Hl7.Structure}">
                                    <TreeView ItemsSource="{Binding Hl7Segments}"
                                              Background="{DynamicResource CardBackgroundBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}"
                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                              Margin="0,8,0,0">
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Fields}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <TextBlock Text="  " />
                                                    <TextBlock Text="{Binding Group, Mode=OneWay}"
                                                               Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                                <HierarchicalDataTemplate.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Path, Mode=OneWay}" MinWidth="90" />
                                                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                                       Style="{StaticResource CaptionTextStyle}" MinWidth="140" />
                                                            <TextBlock Text="{Binding Value, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </HierarchicalDataTemplate.ItemTemplate>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </TabItem>

                                <TabItem Header="{loc:Localize Settings.Hl7.Issues}">
                                    <DataGrid ItemsSource="{Binding Hl7Issues}"
                                              Style="{StaticResource ReadOnlyDataGridStyle}"
                                              Margin="0,8,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{loc:Localize Settings.Hl7.Where}"
                                                                Binding="{Binding Location}" Width="130" />
                                            <DataGridTextColumn Header="{loc:Localize Settings.Hl7.What}"
                                                                Binding="{Binding Message}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>

                                <TabItem Header="{loc:Localize Settings.Hl7.OnTheWire}">
                                    <TextBox Text="{Binding Hl7Preview, Mode=OneWay}"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas, Courier New"
                                             Margin="0,8,0,0" />
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Localize Settings.Tab.Appearance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <StackPanel MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Localize Settings.Language}" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,18" />

                        <CheckBox Content="{loc:Localize Settings.DarkMode}"
                                  IsChecked="{Binding Working.DarkMode}"
                                  Style="{StaticResource SettingCheckBoxStyle}" />
                        <CheckBox Content="{loc:Localize Settings.ShowAdvancedFields}"
                                  IsChecked="{Binding Working.ShowAdvancedFields}"
                                  Style="{StaticResource SettingCheckBoxStyle}" />
                        <CheckBox Content="{loc:Localize Settings.ConfirmBeforeSending}"
                                  IsChecked="{Binding Working.ConfirmBeforeSending}"
                                  Style="{StaticResource SettingCheckBoxStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="24,2,0,0"
                                   Text="Keeping confirmation switched on is strongly recommended in clinical use. It is the last check that the document matches the patient." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Localize Action.Cancel}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" MinWidth="120" MinHeight="40" Margin="0,0,10,0" />
            <Button Content="{loc:Localize Action.Save}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="140" MinHeight="40"
                    IsDefault="True"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
