<Window x:Class="PdfToDicom.App.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PdfToDicom.App.Infrastructure"
        Title="{loc:Localize LogViewer.Title}"
        Height="620" Width="960"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBoxStyle}"
                     ToolTip="{loc:Localize TagViewer.Search}" />

            <CheckBox Grid.Column="1" Content="{loc:Localize LogViewer.Follow}"
                      IsChecked="{Binding FollowNewEntries}"
                      Style="{StaticResource SettingCheckBoxStyle}"
                      Margin="14,0,0,0" />

            <Button Grid.Column="2" Content="{loc:Localize LogViewer.OpenFolder}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding OpenFolderCommand}"
                    MinWidth="140" Margin="10,0,0,0" />
        </Grid>

        <DataGrid x:Name="EntriesGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Entries}"
                  Style="{StaticResource ReadOnlyDataGridStyle}"
                  FontFamily="Consolas, Courier New">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="100" />
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding LogFolder}"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="1" Content="{loc:Localize Action.Close}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" MinWidth="120" MinHeight="38" />
        </Grid>
    </Grid>
</Window>
