<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The HL7 version 2 protocol adapter: the message model, the ER7 codec and the
    character set rules.

    It has NO package references and no reference to PdfToDicom.Core. That is
    deliberate rather than incidental. This assembly knows what a segment is and
    nothing whatever about DICOM, about this product's configuration or about any
    particular vendor, which is what allows it to be exercised on its own and keeps
    the clinical code it will eventually serve out of reach of a parser bug.

    Nothing references it yet. The desktop application and the command line tool pick
    it up when the engine above it exists, so adding it changes neither the published
    output nor the installer today.
  -->
  <ItemGroup>
    <ProjectReference Include="..\PdfToDicom.Interop\PdfToDicom.Interop.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PdfToDicom.Interop.Hl7V2</RootNamespace>
    <AssemblyName>PdfToDicom.Interop.Hl7V2</AssemblyName>
  </PropertyGroup>

</Project>
