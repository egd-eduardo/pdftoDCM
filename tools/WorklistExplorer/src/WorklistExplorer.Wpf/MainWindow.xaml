<Window x:Class="WorklistExplorer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Worklist Explorer (read only: C-ECHO and C-FIND only)"
        Width="1400" Height="900" MinWidth="900" MinHeight="600">
    <DockPanel Margin="8">

        <!-- Status line -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="0,4,0,0" Margin="0,6,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Load a configuration or add a server by hand." />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Configuration file -->
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Style="{StaticResource Label}" Text="Configuration (opened read only):" />
                <Button DockPanel.Dock="Right" Content="Load" Click="OnLoadConfig" />
                <Button DockPanel.Dock="Right" Content="Browse..." Click="OnBrowseConfig" />
                <TextBox x:Name="ConfigPathBox" Margin="0,0,6,0" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Row="1" x:Name="ConfigNotes" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,4" />

            <!-- Servers: every imported setting is visible, including the filters that may be excluding rows -->
            <DataGrid Grid.Row="2" x:Name="ServersGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                      CanUserSortColumns="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Query" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Origin" Binding="{Binding Origin, Mode=OneWay}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Enabled in file" Binding="{Binding ImportedIsEnabled, Mode=OneWay}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Calling AE" Binding="{Binding CallingAeTitle}" />
                    <DataGridTextColumn Header="Called AE" Binding="{Binding CalledAeTitle}" />
                    <DataGridTextColumn Header="Host" Binding="{Binding Host}" />
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" />
                    <DataGridCheckBoxColumn Header="TLS" Binding="{Binding UseTls, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridCheckBoxColumn Header="Accept any cert" Binding="{Binding AcceptAnyTlsCertificate, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Modality sent" Binding="{Binding Modality}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="DarkRed" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Station sent" Binding="{Binding ScheduledStationAeTitle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="DarkRed" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Timeout (s)" Binding="{Binding TimeoutSeconds}" />
                    <DataGridTextColumn Header="Modality in file" Binding="{Binding ImportedModality, Mode=OneWay}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Station in file" Binding="{Binding ImportedStation, Mode=OneWay}" IsReadOnly="True" />
                    <DataGridTextColumn Header="DateRange in file" Binding="{Binding ImportedDateRange, Mode=OneWay}" IsReadOnly="True" />
                    <DataGridTextColumn Header="MaximumResults in file" Binding="{Binding ImportedMaximumResults, Mode=OneWay}" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,4">
                <Button Content="Add server by hand" Click="OnAddServer" />
                <Button Content="Remove selected" Click="OnRemoveServer" />
                <Button Content="Clear modality and station filters" Click="OnClearFilters"
                        ToolTip="Sends empty Modality and Scheduled Station AE keys: the plainest question." />
                <Button Content="Restore filters from file" Click="OnRestoreFilters" />
                <Button Content="C-ECHO ticked" Click="OnEcho" />
                <TextBlock Style="{StaticResource Label}" Foreground="#555" Margin="12,0,0,0"
                           Text="Values in red are sent as matching keys; a non empty one excludes everything else." />
            </StackPanel>

            <!-- The question -->
            <WrapPanel Grid.Row="4" Margin="0,0,0,4">
                <TextBlock Style="{StaticResource Label}" Text="Scheduled date:" />
                <ComboBox x:Name="DateModeBox" Width="170" Margin="0,0,6,0" SelectionChanged="OnDateModeChanged">
                    <ComboBoxItem Content="Any date (no date key)" Tag="AnyDate" IsSelected="True" />
                    <ComboBoxItem Content="Today" Tag="Today" />
                    <ComboBoxItem Content="Yesterday and today" Tag="YesterdayAndToday" />
                    <ComboBoxItem Content="Last seven days" Tag="LastSevenDays" />
                    <ComboBoxItem Content="Explicit from and to" Tag="Explicit" />
                </ComboBox>
                <TextBlock Style="{StaticResource Label}" Text="From:" />
                <DatePicker x:Name="FromPicker" Width="120" Margin="0,0,6,0" IsEnabled="False" SelectedDateFormat="Short" />
                <TextBlock Style="{StaticResource Label}" Text="To:" />
                <DatePicker x:Name="ToPicker" Width="120" Margin="0,0,12,0" IsEnabled="False" SelectedDateFormat="Short" />
                <TextBlock Style="{StaticResource Label}" Text="Safety ceiling per server:" />
                <TextBox x:Name="CeilingBox" Width="90" Margin="0,0,12,0" VerticalContentAlignment="Center" Text="1000000" />
                <CheckBox x:Name="RawModeBox" Content="Raw mode, write every dataset to:" VerticalAlignment="Center"
                          Margin="0,0,6,0" Checked="OnRawModeChanged" Unchecked="OnRawModeChanged" />
                <TextBox x:Name="RawFolderBox" Width="220" Margin="0,0,6,0" VerticalContentAlignment="Center" IsEnabled="False" />
                <Button x:Name="RawBrowseButton" Content="Folder..." Click="OnBrowseRawFolder" IsEnabled="False" />
                <Button x:Name="QueryButton" Content="Query ticked servers" FontWeight="Bold" Margin="12,0,6,0" Click="OnQuery" />
                <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="OnCancel" />
            </WrapPanel>

            <TextBlock Grid.Row="5" x:Name="RawWarning" Visibility="Collapsed" Foreground="White" Background="DarkRed"
                       Padding="6,3" Margin="0,0,0,4" TextWrapping="Wrap" FontWeight="Bold"
                       Text="Raw mode writes every received dataset to disk. These files contain patient identifiable data. Choose a protected folder and delete the files when the investigation is over, according to Affidea policy." />

            <TabControl Grid.Row="6" x:Name="Tabs">
                <TabItem Header="Results">
                    <DockPanel Margin="4">
                        <TextBlock DockPanel.Dock="Top" x:Name="CeilingBanner" Visibility="Collapsed" Foreground="White"
                                   Background="DarkRed" Padding="6,3" Margin="0,0,0,4" TextWrapping="Wrap" FontWeight="Bold" />
                        <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,4" />

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource Label}"
                                       Text="Local filter on patient name, patient ID and accession (accents and case ignored; * and ? as typed):" />
                            <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearLocalFilter" />
                            <TextBox x:Name="LocalFilterBox" Margin="0,0,6,0" VerticalContentAlignment="Center" TextChanged="OnLocalFilterChanged" />
                        </DockPanel>

                        <!-- Pager -->
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <Button Content="First" Click="OnFirstPage" />
                            <Button Content="Previous" Click="OnPreviousPage" />
                            <TextBlock x:Name="PageText" Style="{StaticResource Label}" MinWidth="260" TextAlignment="Center" />
                            <Button Content="Next" Click="OnNextPage" />
                            <Button Content="Last" Click="OnLastPage" />
                            <TextBlock Style="{StaticResource Label}" Text="Page size:" Margin="12,0,6,0" />
                            <TextBox x:Name="PageSizeBox" Width="60" Text="500" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="Apply" Click="OnApplyPageSize" />
                            <TextBlock x:Name="TotalsText" Style="{StaticResource Label}" Margin="12,0,12,0" FontWeight="Bold" />
                            <Button Content="Export this page to CSV" Click="OnExportPage" />
                            <Button x:Name="ExportAllButton" Content="Export everything fetched to CSV" Click="OnExportAll" />
                        </WrapPanel>

                        <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" Sorting="OnResultsSorting"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="Diagnostics">
                    <DockPanel Margin="4">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Save diagnostics as..." Click="OnSaveDiagnostics" />
                            <Button Content="Clear" Click="OnClearDiagnostics" />
                            <TextBlock x:Name="LogPathText" Style="{StaticResource Label}" Foreground="#555" />
                        </StackPanel>
                        <TextBox x:Name="DiagnosticsBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" AcceptsReturn="True" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
