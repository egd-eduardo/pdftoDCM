<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A Modality Worklist SCP for testing, and only for testing.

    It exists because a site adopting the worklist feature usually has no worklist server
    it can point a test workstation at: the real one holds live patient data and is not
    somewhere to try a new application against. This serves a handful of invented
    scheduled procedure steps over a real DICOM association, so the whole path can be
    exercised without touching anything clinical.

    It is NOT part of what a hospital receives. The packaging scripts copy a named list of
    files and this is not on it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PdfToDicom.TestWorklistServer</RootNamespace>
    <AssemblyName>testworklistserver</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- So it can be published for the architectures a test machine might be. -->
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="fo-dicom" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The name list travels inside the executable, so the server can be copied to a test
      machine as one file, exactly as the application is.

      Two things here are deliberate, because the obvious spelling silently does the wrong
      thing. The file is named names-pt-PT.txt with a hyphen, not names.pt-PT.txt: MSBuild
      reads the segment between the last two dots of a resource file name as a CULTURE, so
      the dotted form was taken for Portuguese (Portugal) and compiled into a
      pt-PT/testworklistserver.resources.dll satellite instead of into the assembly. The
      resource then could not be found at run time, and the single file publish gained a
      loose directory beside the executable.

      LogicalName pins the name the code asks for, so a future rename cannot quietly
      change it again.
    -->
    <EmbeddedResource Include="names-pt-PT.txt" LogicalName="PdfToDicom.TestWorklistServer.names-pt-PT.txt" />
  </ItemGroup>

</Project>
